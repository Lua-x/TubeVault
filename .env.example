# TubeVault – example configuration
# Copy to `.env` and adjust. Never commit your real `.env`.

# --- Container ---------------------------------------------------------------
# User and group the app runs as (files in /config and /media belong to them).
PUID=1000
PGID=1000
# Time zone, e.g. Europe/Berlin
TZ=Europe/Berlin

# --- Server ------------------------------------------------------------------
# Port the web interface listens on inside the container.
PORT=8096
# Sub-path when served behind a reverse proxy, e.g. /tubevault. Empty = root.
BASE_PATH=
# IPs of reverse proxies whose X-Forwarded-* headers are trusted ("*" = all).
FORWARDED_ALLOW_IPS=*
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- First start -------------------------------------------------------------
# Creates this admin account if no user exists yet. If left empty, you create
# the admin account in the browser on first visit.
ADMIN_USER=
ADMIN_PASSWORD=

# --- yt-dlp ------------------------------------------------------------------
# Update yt-dlp to the latest release every time the container starts.
YTDLP_AUTO_UPDATE=true
