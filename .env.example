# TubeVault – example configuration
# Copy to `.env` and adjust. Never commit your real `.env`.

# --- Container ---------------------------------------------------------------
# User and group the app runs as (files in /config and /media belong to them).
PUID=1000
PGID=1000
# Time zone, e.g. Europe/Berlin
TZ=Europe/Berlin

# --- Server ------------------------------------------------------------------
# Port the web interface listens on inside the container. Default: 8823 – installs from
# before 1.0 keep 8096 unless this is set.
# PORT=8823
# Sub-path when served behind a reverse proxy, e.g. /tubevault. Empty = root.
BASE_PATH=
# IPs of reverse proxies whose X-Forwarded-* headers are trusted ("*" = all).
FORWARDED_ALLOW_IPS=*
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- First start -------------------------------------------------------------
# Creates this admin account if no user exists yet. If left empty, you create
# the admin account in the browser on first visit.
ADMIN_USER=
ADMIN_PASSWORD=

# --- yt-dlp ------------------------------------------------------------------
# Update yt-dlp to the latest release every time the container starts.
YTDLP_AUTO_UPDATE=true

# --- Login via an OpenID Connect provider (optional) -------------------------
# Authelia, Authentik, Keycloak, Pocket ID, … Leave OIDC_ISSUER empty to turn it off.
# Register TubeVault at the provider with the redirect URI shown in Verwaltung,
# e.g. https://tube.example.com/api/auth/oidc/callback
PUBLIC_URL=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Text on the login button: "Mit … anmelden"
OIDC_NAME=SSO
# Members of this group become admins (empty = rights are managed in TubeVault).
OIDC_ADMIN_GROUP=
# Only change these if your provider needs it (Keycloak: OIDC_SCOPES=openid profile email).
# OIDC_SCOPES=openid profile email groups
# OIDC_USERNAME_CLAIM=preferred_username
# OIDC_GROUPS_CLAIM=groups
# Create unknown accounts on first login (false: only linked accounts may log in).
OIDC_AUTO_CREATE=true
# client_secret_basic (default) or client_secret_post – as configured at the provider.
OIDC_TOKEN_AUTH=client_secret_basic
# false: only the provider (keeps working as a fallback while OIDC is not set up).
PASSWORD_LOGIN=true
